<%@ Master Language="VB" AutoEventWireup="false" CodeBehind="Site.Master.vb" Inherits="Al_Asimquran.Site" %>
<!DOCTYPE html>
<html lang="en">
<head id="Head1" runat="server">
<meta charset="utf-8" />
<meta http-equiv="X-UA-Compatible" content="IE=edge" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title><asp:ContentPlaceHolder ID="TitleContent" runat="server">Al Asim Quran – Learn Quran Online &amp; Islamic Education</asp:ContentPlaceHolder></title>
<link rel="icon" type="image/png" href="<%= ResolveUrl("~/assets/img/icons/al-asim-logo-black-transparent.png") %>" />
<link rel="preconnect" href="https://fonts.googleapis.com/" />
<link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin="crossorigin" />
<link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Lexend:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="<%= ResolveUrl("~/assets/vendor/bootstrap/css/bootstrap.min.css") %>" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css" />
<link rel="stylesheet" href="<%= ResolveUrl("~/assets/vendor/themify/themify.css") %>" />
<link rel="stylesheet" href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" />
<link rel="stylesheet" href="<%= ResolveUrl("~/assets/css/meanmenu.css") %>" />
<link rel="stylesheet" href="<%= ResolveUrl("~/assets/css/preloader.css") %>" />
<link rel="stylesheet" href="<%= ResolveUrl("~/assets/css/animate.css") %>" />
<link rel="stylesheet" href="<%= ResolveUrl("~/assets/css/swiper-bundle.min.css") %>" />
<link rel="stylesheet" href="<%= ResolveUrl("~/assets/css/magnific-popup.css") %>" />
<link rel="stylesheet" href="<%= ResolveUrl("~/assets/css/niceselect.css") %>" />
<link rel="stylesheet" href="<%= ResolveUrl("~/assets/css/style.css?v=76") %>" />
<link rel="stylesheet" href="<%= ResolveUrl("~/assets/css/responsive.css?v=4") %>" />
<asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>

<!-- Preloader -->
<div class="preloader_wrap">
    <img src="<%= ResolveUrl("~/assets/img/icons/al-asim-logo-black-transparent.png") %>" class="pre_logo" alt="Al-Asim Quran" style="max-height: 60px; width: auto; background: transparent;" />
    <span class="preloader"></span>
</div>	

<!-- Offcanvas Area Start (Mobile Menu / Drawer) -->
<div class="fix-area">
	<div class="offcanvas__info">
		<div class="offcanvas__wrapper">
			<div class="offcanvas__content">
				<div class="offcanvas__top d-flex justify-content-between align-items-center">
					<div class="offcanvas__logo">
						<a href="<%= ResolveUrl("~/Default.aspx") %>">
							<img src="<%= ResolveUrl("~/assets/img/icons/al-asim-logo-black-transparent.png") %>" alt="Al-Asim Quran" style="max-height: 48px; width: auto;" />
						</a>
					</div>
					<div class="offcanvas__close">
						<button type="button" aria-label="Close menu">
							<i class="fa-solid fa-xmark"></i>
						</button>
					</div>
				</div>
				<p>
					Al-Asim Quran is a dedicated online Islamic academy offering comprehensive Quran reading with Tajweed, Hifz, Tafseer, and Arabic language for students of all ages across the globe.
				</p>
				
				<!-- Mobile Menu Container (Populated by MeanMenu) -->
				<div class="mobile-menu fix mb-3"></div>  

				<div class="offcanvas__contact">
					<h4>Contact Info</h4>
					<ul>
						<li class="d-flex align-items-center">
							<div class="offcanvas__contact-icon">
								<i class="fas fa-map-marker-alt"></i>
							</div>
							<div class="offcanvas__contact-text">
								<a href="<%= ResolveUrl("~/contact.aspx") %>">Serving Students Online Worldwide in 20+ Countries</a>
							</div>
						</li>
						<li class="d-flex align-items-center">
							<div class="offcanvas__contact-icon mr-15">
								<i class="fas fa-envelope"></i>
							</div>
							<div class="offcanvas__contact-text">
								<a href="mailto:alasimquran@gmail.com?subject=Inquiry%20to%20Al-Asim%20Quran&amp;body=Assalamu%20Alaikum%2C%0D%0A%0D%0AI%20would%20like%20to%20know%20more%20about%20your%20Quran%20courses.%0D%0A%0D%0AName%3A%0D%0ACourse%20of%20interest%3A%0D%0APreferred%20class%20time%3A%0D%0A%0D%0AJazakAllah%20Khair" aria-label="Email Al-Asim Quran"><span>alasimquran@gmail.com</span></a>
							</div>
						</li>
						<li class="d-flex align-items-center">
							<div class="offcanvas__contact-icon mr-15">
								<i class="fas fa-clock"></i>
							</div>
							<div class="offcanvas__contact-text">
								<a href="<%= ResolveUrl("~/inquiry.aspx") %>">24/7 Flexible Timings &amp; Schedules</a>
							</div>
						</li>
						<li class="d-flex align-items-center">
							<div class="offcanvas__contact-icon mr-15">
								<i class="fas fa-phone"></i>
							</div>
							<div class="offcanvas__contact-text">
								<a href="tel:+923424852893">0342-4852893</a> / <a href="https://wa.me/923424852893" target="_blank" rel="noopener noreferrer">WhatsApp</a>
							</div>
						</li>
					</ul>
					
					<div class="header-button mt-4 d-grid gap-2">
						<a href="<%= ResolveUrl("~/free-trial.aspx") %>" class="green_btn text-center">
							<span>Book Free Trial</span>
						</a>
					</div>
										
					<h4 class="mb-2 mt-4">Follow Us</h4>
					<div class="sidebar-social mt-3 d-flex gap-3 align-items-center">
						<a href="https://web.facebook.com/profile.php?id=61595788242425" target="_blank" rel="noopener noreferrer" title="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
						<a href="https://www.instagram.com/al_asimquran?srtk=MXhpNnJ4d3l1ZGtleg==" target="_blank" rel="noopener noreferrer" title="Instagram"><i class="fa-brands fa-instagram"></i></a>
						<a href="https://www.tiktok.com/@al_asimquran?_r=1&_t=ZS-9Az307IrOAn" target="_blank" rel="noopener noreferrer" title="TikTok"><i class="fa-brands fa-tiktok"></i></a>
						<a href="https://youtube.com/@alasimquran?si=kPHQ2D-LUfIQuLoc" target="_blank" rel="noopener noreferrer" title="YouTube"><i class="fa-brands fa-youtube"></i></a>					
						<a href="https://wa.me/923424852893" target="_blank" rel="noopener noreferrer" title="WhatsApp"><i class="fa-brands fa-whatsapp"></i></a>					
					</div>
				</div>						
			</div>
		</div>
	</div>
</div>

<div class="offcanvas__overlay"></div>
<!-- Offcanvas Area End -->

<!-- ===================== START HEADER ===================== -->
<header id="navigation">

	<!-- Header Top Bar -->
	<div class="header-top am-header-top-bar">
		<div class="container-fluid px-3 px-xl-4 position-relative">
			<div class="row align-items-center g-2 am-header-top-row">
				
				<!-- Left info -->
				<div class="col-xl-4 col-lg-4 col-12 htleft am-header-contact d-flex align-items-center justify-content-center justify-content-lg-start">
					<div class="am-header-contact-stack">
						<div class="am-header-welcome">Welcome to Al-Asim Quran!</div>
						<a class="am-header-contact-line" href="mailto:alasimquran@gmail.com"><i class="fa-solid fa-envelope" aria-hidden="true"></i> <span>alasimquran@gmail.com</span></a>
						<a class="am-header-contact-line" href="tel:+923424852893"><i class="fa-solid fa-phone" aria-hidden="true"></i> <span>0342-4852893</span></a>
					</div>
				</div><!-- End Col -->

				<!-- Center Bismillah Calligraphy (Dead Center of the Bar) -->
				<div class="bis_himage_center d-none d-lg-flex justify-content-center align-items-center">
					<img src="<%= ResolveUrl("~/assets/img/icons/topmidloogo-transparent.png?v=3") %>" alt="Al-Asim Quran calligraphy" class="am-bismillah-img" />
				</div>

				<!-- Right info: Sunrise & Sunset on top, Social Icons below, flush to right edge -->
				<div class="col-xl-4 col-lg-4 col-12 ms-auto htright d-flex justify-content-center justify-content-lg-end align-items-center">
					<div class="am-ht-right-box">
						<div class="social_icons d-flex align-items-center justify-content-center justify-content-lg-end gap-2">
							<a href="https://web.facebook.com/profile.php?id=61595788242425" target="_blank" rel="noopener noreferrer" title="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
							<a href="https://www.instagram.com/al_asimquran?srtk=MXhpNnJ4d3l1ZGtleg==" target="_blank" rel="noopener noreferrer" title="Instagram"><i class="fa-brands fa-instagram"></i></a>
							<a href="https://www.tiktok.com/@al_asimquran?_r=1&_t=ZS-9Az307IrOAn" target="_blank" rel="noopener noreferrer" title="TikTok"><i class="fa-brands fa-tiktok"></i></a>
							<a href="https://youtube.com/@alasimquran?si=kPHQ2D-LUfIQuLoc" target="_blank" rel="noopener noreferrer" title="YouTube"><i class="fa-brands fa-youtube"></i></a>
							<a href="https://wa.me/923424852893" target="_blank" rel="noopener noreferrer" title="WhatsApp"><i class="fa-brands fa-whatsapp"></i></a>
						</div>
						<div class="am-follow-label">Follow us!</div>
					</div>
				</div><!-- End Col -->

			</div>
		</div>
	</div><!-- End Header Top -->
	
	<!-- Main Navigation Bar -->
	<div class="main-header">							
		<div class="container-fluid">
			<div class="row align-items-center">
				
				<!-- Logo -->
				<div class="col-xl-2 col-md-3 col-sm-4 col-5">
					<div class="site-logo">
						<a href="<%= ResolveUrl("~/Default.aspx") %>" title="Al-Asim Quran">
							<img src="<%= ResolveUrl("~/assets/img/icons/navbarlogo-transparent.png?v=2") %>" alt="Al-Asim Quran" />
						</a>
					</div>
				</div><!-- End Col -->

				<!-- Center Menu -->
				<div class="col-xl-7 col-md-6 d-none d-xl-block align-self-center">
					<div class="header-left d-flex justify-content-center">								
						<nav id="main-menu">
							<ul>
								<li><a href="<%= ResolveUrl("~/Default.aspx") %>">Home</a></li>
								
								<!-- Who We Are Dropdown -->
								<li class="menu-item-has-children">
									<a href="javascript:void(0);" class="nav-dropdown-toggle">Who We Are</a>
									<ul class="sub-menu">
										<li><a href="<%= ResolveUrl("~/our-story.aspx") %>">Our Story</a></li>
