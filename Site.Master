												<li><a href="<%= ResolveUrl("~/team-management.aspx") %>">Team Management</a></li>
												<li><a href="<%= ResolveUrl("~/why-choose-al-asim-quran.aspx") %>">Why Choose Us</a></li>
												<li><a href="<%= ResolveUrl("~/aims-and-objectives.aspx") %>">Aims &amp; Objectives</a></li>
											</ul>
										</li>
										<li><a href="<%= ResolveUrl("~/our-certificate.aspx") %>">Our Certificate</a></li>
										<li><a href="<%= ResolveUrl("~/our-registration.aspx") %>">Our Registration</a></li>
										<li><a href="<%= ResolveUrl("~/inquiry.aspx") %>">Inquiry Page</a></li>
									</ul>
								</li>

								<!-- Courses Dropdown -->
								<li class="menu-item-has-children">
									<a href="javascript:void(0);" class="nav-dropdown-toggle">Courses</a>
									<ul class="sub-menu">
										<li><a href="<%= ResolveUrl("~/quran-reading-for-beginners.aspx") %>">Quran Reading (Nazra)</a></li>
										<li><a href="<%= ResolveUrl("~/noorani-qaida.aspx") %>">Noorani Qaida</a></li>
										<li><a href="<%= ResolveUrl("~/quran-with-tajweed.aspx") %>">Quran with Tajweed</a></li>
										<li><a href="<%= ResolveUrl("~/hifz-ul-quran.aspx") %>">Hifz-ul-Quran</a></li>
										<li><a href="<%= ResolveUrl("~/tafseer-and-translation.aspx") %>">Tafseer &amp; Translation</a></li>
										<li><a href="<%= ResolveUrl("~/daily-islamic-supplications.aspx") %>">Daily Duas &amp; Sunnah</a></li>
										<li class="menu-item-has-children am-nested-hover-menu am-islamic-studies-menu">
											<a href="<%= ResolveUrl("~/islamic-studies.aspx") %>" class="nav-dropdown-toggle">Islamic Studies</a>
											<ul class="sub-menu">
												<li><a href="<%= ResolveUrl("~/pillars-of-islam.aspx") %>">Pillars of Islam</a></li>
											</ul>
										</li>
										<li><a href="<%= ResolveUrl("~/arabic-language.aspx") %>">Arabic Language</a></li>
										<li><a href="<%= ResolveUrl("~/courses.aspx") %>">Courses &amp; Fee Plans</a></li>
									</ul>
								</li>

								<!-- Explore Dropdown (Renamed from Pages) -->
								<li class="menu-item-has-children">
									<a href="javascript:void(0);" class="nav-dropdown-toggle">Explore</a>
									<ul class="sub-menu">
										<li><a href="<%= ResolveUrl("~/spiritual-development.aspx") %>">Spiritual Development</a></li>
										<li><a href="<%= ResolveUrl("~/tutors.aspx") %>">Meet Qualified Tutors</a></li>
										<li><a href="<%= ResolveUrl("~/testimonials.aspx") %>">Testimonials | Reviews</a></li>
										<li><a href="<%= ResolveUrl("~/events.aspx") %>">Events</a></li>
										<li><a href="<%= ResolveUrl("~/announcements.aspx") %>">Announcements</a></li>
										<li><a href="<%= ResolveUrl("~/gallery.aspx") %>">Official Gallery</a></li>
										<li><a href="<%= ResolveUrl("~/downloads.aspx") %>">Downloads</a></li>
										<li><a href="<%= ResolveUrl("~/online-payments.aspx") %>">Online Payments</a></li>
										<li><a href="<%= ResolveUrl("~/free-trial.aspx") %>">Free Trial Classes</a></li>
						<li><a href="<%= ResolveUrl("~/modern-integrations.aspx") %>">Integrations</a></li>
									</ul>
								</li>

								<li><a href="<%= ResolveUrl("~/blog.aspx") %>">Blog</a></li>

								<li><a href="<%= ResolveUrl("~/contact.aspx") %>">Contact</a></li>
								<li><a href="<%= ResolveUrl("~/support.aspx") %>">Support Center</a></li>
							</ul>
						</nav><!-- End Main Menu -->							
					</div>
				</div>
				<!-- End Col -->			
				
				<!-- Right Controls: Search, Join Now, Burger -->
				<div class="col-xl-3 col-md-9 col-sm-8 col-7 align-self-center">
					<div class="header_right d-flex gap-3 justify-content-end align-items-center">	
						<a class="search_btn align-self-center" data-menu="#popup_searchbox" href="javascript:void(0);" title="Search Courses">
							<i class="ph ph-magnifying-glass"></i>
						</a>
						<a class="green_btn align-self-center d-none d-sm-block" href="<%= ResolveUrl("~/free-trial.aspx") %>">
							<span>JOIN NOW</span>
						</a>
						<a href="javascript:void(0);" class="widget_menu_icon" aria-label="Open Mobile Menu">
							<i class="ph ph-list"></i>
						</a>
					</div>
				</div>
				<!-- End Col -->			

			</div>
		</div>
	</div>	
</header>
<!-- ===================== END HEADER ===================== -->

<!-- Start Popup Search Box -->
<div id="popup_searchbox" class="popup_searchbox_wrapper">
	<div class="searchbox_drawer position-relative">
		<a href="javascript:void(0);" class="popup_close"><i class="bx bx-x"></i></a>				
		<div class="popup_searchform text-center">
			<div class="col-lg-7 mx-auto">
				<form action="courses.aspx" class="position-relative" method="get">
					<input type="text" name="q" placeholder="What are you looking for? Search courses, tajweed, hifz..." />
					<button type="submit"><i class="ph ph-magnifying-glass"></i> Search</button>
				</form>
			</div>									
		</div>									
	</div>
</div>			
<!-- End Popup Search Box -->

<!-- Arabic Hadith & Quranic Ayat Ticker (Running Islamic Ribbon) -->
<div class="am-islamic-ribbon">
	<div class="container-fluid px-3">
		<div class="am-ribbon-inner">
			<div class="am-ribbon-tag">
				<i class="fa-solid fa-book-quran"></i>
				<span>فرمانِ نبوی ﷺ و قرآنِ مجید</span>
			</div>
			<div class="am-ribbon-marquee">
				<div class="am-ribbon-track">
					<span class="am-ribbon-item">
						<span class="am-ar">«خَيْرُكُمْ مَنْ تَعَلَّمَ الْقُرْآنَ وَعَلَّمَهُ»</span>
						<span class="am-sep">•</span>
						<span class="am-ur">"تم میں سے بہترین وہ ہے جو قرآن سیکھے اور سکھائے" (صحیح بخاری)</span>
						<span class="am-sep">•</span>
						<span class="am-en">"The best among you are those who learn the Quran and teach it." (Bukhari)</span>
					</span>
					<span class="am-star">✦</span>
					<span class="am-ribbon-item">
						<span class="am-ar">﴿وَرَتِّلِ الْقُرْآنَ تَرْتِيلًا﴾</span>
						<span class="am-sep">•</span>
						<span class="am-ur">"اور قرآن کو ٹھہر ٹھہر کر صاف پڑھا کرو" (سورۃ المزمل: 4)</span>
						<span class="am-sep">•</span>
						<span class="am-en">"And recite the Quran with measured recitation." (Surah Al-Muzzammil)</span>
					</span>
					<span class="am-star">✦</span>
					<span class="am-ribbon-item">
						<span class="am-ar">«طَلَبُ الْعِلْمِ فَرِيضَةٌ عَلَىٰ كُلِّ مُسْلِمٍ»</span>
						<span class="am-sep">•</span>
						<span class="am-ur">"علم حاصل کرنا ہر مسلمان پر فرض ہے" (ابن ماجہ)</span>
						<span class="am-sep">•</span>
						<span class="am-en">"Seeking knowledge is an obligation upon every Muslim." (Ibn Majah)</span>
					</span>
					<span class="am-star">✦</span>
					<span class="am-ribbon-item">
						<span class="am-ar">﴿إِنَّ هَٰذَا الْقُرْآنَ يَهْدِي لِلَّتِي هِيَ أَقْوَمُ﴾</span>
						<span class="am-sep">•</span>
						<span class="am-ur">"بے شک یہ قرآن اس راستے کی رہنمائی کرتا ہے جو سب سے سیدھا ہے" (سورۃ الاسراء: 9)</span>
						<span class="am-sep">•</span>
						<span class="am-en">"Indeed, this Quran guides to that which is most upright." (Surah Al-Isra)</span>
					</span>
					<span class="am-star">✦</span>
					<span class="am-ribbon-item">
						<span class="am-ar">«الْمَاهِرُ بِالْقُرْآنِ مَعَ السَّفَرَةِ الْكِرَامِ الْبَرَرَةِ»</span>
						<span class="am-sep">•</span>
						<span class="am-ur">"قرآن کا ماہر معزز اور نیک فرشتوں کے ساتھ ہوگا" (صحیح مسلم)</span>
						<span class="am-sep">•</span>
						<span class="am-en">"The one proficient in the Quran is with the noble righteous scribes." (Muslim)</span>
					</span>
					<span class="am-star">✦</span>
					<!-- Duplicate for continuous marquee loop -->
					<span class="am-ribbon-item">
						<span class="am-ar">«خَيْرُكُمْ مَنْ تَعَلَّمَ الْقُرْآنَ وَعَلَّمَهُ»</span>
						<span class="am-sep">•</span>
						<span class="am-ur">"تم میں سے بہترین وہ ہے جو قرآن سیکھے اور سکھائے" (صحیح بخاری)</span>
						<span class="am-sep">•</span>
						<span class="am-en">"The best among you are those who learn the Quran and teach it." (Bukhari)</span>
					</span>
					<span class="am-star">✦</span>
					<span class="am-ribbon-item">
						<span class="am-ar">﴿وَرَتِّلِ الْقُرْآنَ تَرْتِيلًا﴾</span>
						<span class="am-sep">•</span>
						<span class="am-ur">"اور قرآن کو ٹھہر ٹھہر کر صاف پڑھا کرو" (سورۃ المزمل: 4)</span>
						<span class="am-sep">•</span>
						<span class="am-en">"And recite the Quran with measured recitation." (Surah Al-Muzzammil)</span>
					</span>
					<span class="am-star">✦</span>
					<span class="am-ribbon-item">
						<span class="am-ar">«طَلَبُ الْعِلْمِ فَرِيضَةٌ عَلَىٰ كُلِّ مُسْلِمٍ»</span>
						<span class="am-sep">•</span>
						<span class="am-ur">"علم حاصل کرنا ہر مسلمان پر فرض ہے" (ابن ماجہ)</span>
						<span class="am-sep">•</span>
						<span class="am-en">"Seeking knowledge is an obligation upon every Muslim." (Ibn Majah)</span>
					</span>
				</div>
			</div>
