<!-- Dropdown Click & Accessibility Script -->
<script>
	jQuery(document).ready(function ($) {
		// Toggle dropdown on click instead of refreshing/navigating
		$('#main-menu .menu-item-has-children:not(.am-nested-hover-menu) > a.nav-dropdown-toggle').on('click', function (e) {
			e.preventDefault();
			e.stopPropagation();
			var $parent = $(this).parent('.menu-item-has-children');
			var wasOpen = $parent.hasClass('dropdown-open');
			$parent.siblings('.menu-item-has-children').removeClass('dropdown-open');
			if (!wasOpen) {
				$parent.addClass('dropdown-open');
			} else {
				$parent.find('.menu-item-has-children').removeClass('dropdown-open');
			}
		});

		// Close dropdown when clicking anywhere outside
		$(document).on('click', function (e) {
			if (!$(e.target).closest('#main-menu').length) {
				$('#main-menu .menu-item-has-children').removeClass('dropdown-open');
			}
		});

		// Keep dropdown open when interacting inside sub-menu
		$('#main-menu .sub-menu').on('click', function (e) {
			e.stopPropagation();
		});
	});
</script>

