<%@ Page Title="FAQs | Al-Asim Quran" Language="vb" MasterPageFile="~/Site.Master" AutoEventWireup="false" %>
<asp:Content ID="PageHead" runat="server" ContentPlaceHolderID="HeadContent">
	<meta name="description" content="Find answers about Al-Asim Quran online classes, courses, teachers, schedules, trial lessons and certificates." />
</asp:Content>
<asp:Content ID="PageBody" runat="server" ContentPlaceHolderID="MainContent">
	<section class="main_banner position-relative am-faq-banner" style="background-image: url('assets/img/bg/banner.jpg');">
		<div class="container"><div class="row"><div class="col-12 text-center">
			<span class="am-faq-eyebrow">Al-Asim Quran &bull; Learn Quran Online &amp; Islamic Education</span>
			<h1>Frequently Asked Questions</h1>
			<p><a href="Default.aspx">Home</a> <i class="fa-solid fa-angles-right"></i> FAQs</p>
		</div></div></div>
	</section>

	<section class="am-faq-area section-padding">
		<div class="container">
			<div class="row g-5">
				<div class="col-lg-8">
					<div class="section-heading text-start mb-30 wow fadeInUp">
						<span>Here to help</span><h2>Answers to Your Questions</h2>
						<p>Learn more about our online Quran and Islamic education classes. If you need anything else, our team is happy to help.</p>
					</div>
					<div class="accordion am-faq-accordion" id="faq_accordion">
						<div class="accordion-item"><h2 class="accordion-header" id="faqHeading1"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faqAnswer1" aria-expanded="true" aria-controls="faqAnswer1">What is Al-Asim Quran?</button></h2><div id="faqAnswer1" class="accordion-collapse collapse show" aria-labelledby="faqHeading1" data-bs-parent="#faq_accordion"><div class="accordion-body">Al-Asim Quran is an online Islamic education platform offering Quran Reading, Tajweed, Hifz, Islamic Studies and Arabic Language courses for students worldwide.</div></div></div>
						<div class="accordion-item"><h2 class="accordion-header" id="faqHeading2"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqAnswer2" aria-expanded="false" aria-controls="faqAnswer2">Who can enroll in your courses?</button></h2><div id="faqAnswer2" class="accordion-collapse collapse" aria-labelledby="faqHeading2" data-bs-parent="#faq_accordion"><div class="accordion-body">Our courses are open to children, teenagers, adults and families who wish to learn the Quran and Islamic teachings.</div></div></div>
						<div class="accordion-item"><h2 class="accordion-header" id="faqHeading3"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqAnswer3" aria-expanded="false" aria-controls="faqAnswer3">Do you offer a free trial class?</button></h2><div id="faqAnswer3" class="accordion-collapse collapse" aria-labelledby="faqHeading3" data-bs-parent="#faq_accordion"><div class="accordion-body">Yes. Book a free trial class to experience our teaching approach before enrolling.</div></div></div>
						<div class="accordion-item"><h2 class="accordion-header" id="faqHeading4"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqAnswer4" aria-expanded="false" aria-controls="faqAnswer4">Are classes conducted one-on-one?</button></h2><div id="faqAnswer4" class="accordion-collapse collapse" aria-labelledby="faqHeading4" data-bs-parent="#faq_accordion"><div class="accordion-body">Yes. We provide personalized one-to-one classes to support focused learning and individual attention.</div></div></div>
						<div class="accordion-item"><h2 class="accordion-header" id="faqHeading5"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqAnswer5" aria-expanded="false" aria-controls="faqAnswer5">Do you have male and female teachers?</button></h2><div id="faqAnswer5" class="accordion-collapse collapse" aria-labelledby="faqHeading5" data-bs-parent="#faq_accordion"><div class="accordion-body">Yes. Qualified male and female teachers are available to meet the preferences of students and families.</div></div></div>
						<div class="accordion-item"><h2 class="accordion-header" id="faqHeading6"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqAnswer6" aria-expanded="false" aria-controls="faqAnswer6">What courses do you offer?</button></h2><div id="faqAnswer6" class="accordion-collapse collapse" aria-labelledby="faqHeading6" data-bs-parent="#faq_accordion"><div class="accordion-body">We offer Quran Reading and Noorani Qaida, Tajweed, Hifz-ul-Quran, Tafseer and Translation, Islamic Studies, and Arabic Language courses. <a href="courses.aspx">Explore all courses</a>.</div></div></div>
						<div class="accordion-item"><h2 class="accordion-header" id="faqHeading7"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqAnswer7" aria-expanded="false" aria-controls="faqAnswer7">What are the class timings?</button></h2><div id="faqAnswer7" class="accordion-collapse collapse" aria-labelledby="faqHeading7" data-bs-parent="#faq_accordion"><div class="accordion-body">We offer flexible scheduling options to accommodate students in different countries and time zones. Share your availability with us and we can discuss a suitable time.</div></div></div>
						<div class="accordion-item"><h2 class="accordion-header" id="faqHeading8"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqAnswer8" aria-expanded="false" aria-controls="faqAnswer8">Which countries do you serve?</button></h2><div id="faqAnswer8" class="accordion-collapse collapse" aria-labelledby="faqHeading8" data-bs-parent="#faq_accordion"><div class="accordion-body">Our online classes are available to students worldwide, wherever a stable internet connection is available.</div></div></div>
						<div class="accordion-item"><h2 class="accordion-header" id="faqHeading9"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqAnswer9" aria-expanded="false" aria-controls="faqAnswer9">What technology is required for online classes?</button></h2><div id="faqAnswer9" class="accordion-collapse collapse" aria-labelledby="faqHeading9" data-bs-parent="#faq_accordion"><div class="accordion-body">You need a stable internet connection, a computer, tablet or smartphone, and access to an online meeting platform such as Zoom, Skype or Google Meet.</div></div></div>
						<div class="accordion-item"><h2 class="accordion-header" id="faqHeading10"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqAnswer10" aria-expanded="false" aria-controls="faqAnswer10">How long is each class session?</button></h2><div id="faqAnswer10" class="accordion-collapse collapse" aria-labelledby="faqHeading10" data-bs-parent="#faq_accordion"><div class="accordion-body">Class duration depends on the course and learning plan. Sessions typically range from 30 to 60 minutes.</div></div></div>
						<div class="accordion-item"><h2 class="accordion-header" id="faqHeading11"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqAnswer11" aria-expanded="false" aria-controls="faqAnswer11">How do I register for classes?</button></h2><div id="faqAnswer11" class="accordion-collapse collapse" aria-labelledby="faqHeading11" data-bs-parent="#faq_accordion"><div class="accordion-body">Fill out our <a href="register.aspx">online registration form</a> or send us an <a href="inquiry.aspx">inquiry</a>. Our team will guide you through enrollment.</div></div></div>
						<div class="accordion-item"><h2 class="accordion-header" id="faqHeading12"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqAnswer12" aria-expanded="false" aria-controls="faqAnswer12">Do you provide progress reports?</button></h2><div id="faqAnswer12" class="accordion-collapse collapse" aria-labelledby="faqHeading12" data-bs-parent="#faq_accordion"><div class="accordion-body">Yes. We monitor student progress and provide feedback to help students work towards their learning goals.</div></div></div>
						<div class="accordion-item"><h2 class="accordion-header" id="faqHeading13"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqAnswer13" aria-expanded="false" aria-controls="faqAnswer13">Will I receive a certificate after course completion?</button></h2><div id="faqAnswer13" class="accordion-collapse collapse" aria-labelledby="faqHeading13" data-bs-parent="#faq_accordion"><div class="accordion-body">Certificates are awarded to eligible students upon successful completion of selected courses and programs.</div></div></div>
						<div class="accordion-item"><h2 class="accordion-header" id="faqHeading14"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqAnswer14" aria-expanded="false" aria-controls="faqAnswer14">What if I miss a class?</button></h2><div id="faqAnswer14" class="accordion-collapse collapse" aria-labelledby="faqHeading14" data-bs-parent="#faq_accordion"><div class="accordion-body">Please inform us in advance whenever possible. Rescheduling options may be available according to the class policy; contact our team to discuss your situation.</div></div></div>
						<div class="accordion-item"><h2 class="accordion-header" id="faqHeading15"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqAnswer15" aria-expanded="false" aria-controls="faqAnswer15">How can I contact Al-Asim Quran?</button></h2><div id="faqAnswer15" class="accordion-collapse collapse" aria-labelledby="faqHeading15" data-bs-parent="#faq_accordion"><div class="accordion-body">Reach us through our <a href="inquiry.aspx">contact form</a>, email, phone or WhatsApp. Our support team will be happy to assist you.</div></div></div>
					</div>
				</div>
				<aside class="col-lg-4">
					<div class="am-faq-help wow fadeInRight">
						<div class="am-faq-help-icon"><i class="fa-solid fa-book-open-reader"></i></div>
						<span>Need personal guidance?</span><h2>Let's Find the Right Course for You</h2>
						<p>Tell us who is learning and what you hope to achieve. We can help you choose a class and discuss a suitable schedule.</p>
						<a href="courses.aspx" class="green_border_btn">View Our Courses</a>
						<a href="register.aspx" class="green_btn"><span>Book a Free Trial</span></a>
					</div>
				</aside>
			</div>
		</div>
	</section>
</asp:Content>
