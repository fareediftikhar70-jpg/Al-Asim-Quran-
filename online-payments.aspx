<%@ Page Title="Al-Asim Quran | Online Payments" Language="vb" MasterPageFile="~/Site.Master" AutoEventWireup="false" %>
<asp:Content ID="PageHead" runat="server" ContentPlaceHolderID="HeadContent">
    <meta name="description" content="Review payment methods, fee timing, security, refund policy and international payment options for Al-Asim Quran students worldwide." />
</asp:Content>
<asp:Content ID="PageBody" runat="server" ContentPlaceHolderID="MainContent">
<div class="am-extra-page" style="--am-extra-accent: #198f5b;">
    <section class="main_banner position-relative am-extra-banner" style="background-image: url('assets/img/bg/charity.jpg');">
        <div class="container">
            <div class="row">
                <div class="col-12 text-center">
                    <span class="am-extra-eyebrow">Al-Asim Quran &bull; Learn Quran Online &amp; Islamic Education</span>
                    <h1>Online Payments</h1>
                    <p><a href="Default.aspx">Home</a> <i class="fa-solid fa-angles-right"></i> Online Payments</p>
                </div>
            </div>
        </div>
    </section>

    <section class="am-extra-content section-padding">
        <div class="container">
            <header class="am-extra-lead wow fadeInUp">
                <span>Fee information for students worldwide</span>
                <h2>Safe &amp; Transparent Payment System</h2>
                <p>At Al-Asim Quran, we provide a safe, convenient, and reliable payment system to make it easy for students and parents to pay course fees from anywhere in the world.</p>
            </header>

            <div class="row g-4 am-extra-grid">
                <!-- Card 01 -->
                <div class="col-lg-6">
                    <article class="am-extra-card wow fadeInUp" data-wow-delay="0.00s">
                        <span class="am-extra-index">01</span>
                        <h2>Accepted Payment Methods</h2>
                        <p>We accept multiple verified payment options for your convenience across the globe, including:</p>
                        <ul>
                            <li>Direct Local &amp; International Bank Transfers</li>
                            <li>EasyPaisa &amp; JazzCash (for students in Pakistan)</li>
                            <li>International Remittance &amp; Wire Transfers</li>
                            <li>Secure Online Digital Payment Gateways</li>
                        </ul>
                    </article>
                </div>

                <!-- Card 02 -->
                <div class="col-lg-6">
                    <article class="am-extra-card wow fadeInUp" data-wow-delay="0.08s">
                        <span class="am-extra-index">02</span>
                        <h2>Payment Policy &amp; Schedule</h2>
                        <p>All monthly course fees must be paid according to the agreed schedule at the time of enrollment. Payments should be made at the beginning of each billing cycle to ensure uninterrupted access to live 1-on-1 classes and learning portal resources.</p>
                    </article>
                </div>

                <!-- Card 03 -->
                <div class="col-lg-6">
                    <article class="am-extra-card wow fadeInUp" data-wow-delay="0.16s">
                        <span class="am-extra-index">03</span>
                        <h2>Strict Security &amp; Privacy</h2>
                        <p>We ensure that all financial transactions are handled with end-to-end security measures. Your personal and payment details are encrypted and never disclosed to any unauthorized third party.</p>
                    </article>
                </div>

                <!-- Card 04 -->
                <div class="col-lg-6">
                    <article class="am-extra-card wow fadeInUp" data-wow-delay="0.24s">
                        <span class="am-extra-index">04</span>
                        <h2>Refund &amp; Reschedule Policy</h2>
                        <p>Refunds, if applicable, are processed smoothly according to our Terms &amp; Conditions. Classes missed due to genuine emergencies or advance notices can be rescheduled with your instructor without additional penalty.</p>
                    </article>
                </div>

                <!-- Card 05 -->
                <div class="col-lg-6">
                    <article class="am-extra-card wow fadeInUp" data-wow-delay="0.08s">
                        <span class="am-extra-index">05</span>
                        <h2>24/7 Billing &amp; Payment Support</h2>
                        <p>If you encounter any difficulty while making a payment or need guidance on currency conversion, our accounts desk is available via WhatsApp (<strong>+92 342 4852893</strong>) or email (<strong>alasimquran@gmail.com</strong>) for immediate assistance.</p>
                    </article>
                </div>

                <!-- Card 06 -->
                <div class="col-lg-6">
                    <article class="am-extra-card wow fadeInUp" data-wow-delay="0.16s">
                        <span class="am-extra-index">06</span>
                        <h2>Receipts &amp; Documentation</h2>
                        <p>An official electronic fee receipt and confirmation statement is issued immediately upon receipt of every payment for your family's records and peace of mind.</p>
                    </article>
                </div>
            </div>

            <div class="am-extra-cta wow fadeInUp">
                <div>
                    <span>Al-Asim Quran &bull; Learn Quran Online</span>
                    <h2>Have Questions About Fee Plans or Payment Methods?</h2>
                    <p>Our billing support team will gladly provide fee details for your region.</p>
                </div>
                <a href="inquiry.aspx" class="green_btn">
                    <span>Ask About Payment <i class="fa-solid fa-arrow-right ms-2"></i></span>
                </a>
            </div>
        </div>
    </section>
</div>
</asp:Content>
