<%@ Page Title="Noorani Qaida Course - Al-Asim Quran" Language="vb" MasterPageFile="~/Site.Master" AutoEventWireup="false" %>
<asp:Content ID="PageHead" runat="server" ContentPlaceHolderID="HeadContent">
    <meta name="description" content="Start learning Quran reading with Noorani Qaida. Study Arabic letters, pronunciation, Harakaat, joined words and basic Tajweed in guided online classes." />
</asp:Content>
<asp:Content ID="PageBody" runat="server" ContentPlaceHolderID="MainContent">
    <section class="am-page-hero">
        <div class="container">
            <div class="row align-items-center g-4">
                <div class="col-lg-7 am-page-hero-copy wow fadeInLeft">
                    <div class="am-page-trail">
                        <a href="Default.aspx">Home</a><i class="fa-solid fa-chevron-right"></i>
                        <a href="courses.aspx">Courses</a><i class="fa-solid fa-chevron-right"></i>
                        <span>Noorani Qaida</span>
                    </div>
                    <span class="am-page-kicker"><i class="fa-solid fa-book-open"></i> Quran Reading Foundations</span>
                    <h1>Noorani Qaida Course</h1>
                    <p>Build the skills needed to read the Quran, beginning with Arabic letters and their sounds. Progress through joined letters, vowel marks and basic reading rules with a teacher guiding your practice.</p>
                    <div class="am-page-actions">
                        <a class="green_btn" href="free-trial.aspx"><span>Book Free Trial Class</span></a>
                        <a class="am-page-text-link" href="inquiry.aspx">Ask About the Course <i class="fa-solid fa-arrow-right"></i></a>
                    </div>
                </div>
                <div class="col-lg-5 wow fadeInRight" data-wow-delay=".2s">
                    <div class="am-page-photo-frame">
                        <span class="am-photo-orbit"></span>
                        <img class="am-page-photo" src="assets/img/courses/1.jpg" alt="Student learning Arabic letters for Quran reading" />
                        <div class="am-page-photo-caption"><i class="fa-solid fa-book-quran"></i><span>Start with the foundations</span></div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="section-padding am-info-section">
        <div class="container">
            <div class="section-heading text-center mb-50">
                <span>A Strong Foundation for Quran Reading</span>
                <h2>Learn One Step at a Time</h2>
                <p class="mx-auto" style="max-width:760px;">Noorani Qaida introduces learners to the letters, sounds and reading patterns used in Quranic Arabic. Lessons move gradually from individual letters to connected words and short reading practice.</p>
                <img src="assets/img/icons/title.ico" alt="" />
            </div>
            <div class="row g-4 mb-5">
                <div class="col-lg-4 col-md-6"><article class="am-info-tile p-4 h-100"><span class="am-highlight-icon"><i class="fa-solid fa-font"></i></span><h3 class="mt-3">Arabic Letters</h3><p class="mb-0 text-secondary">Recognize letter names, shapes and sounds, including how letters look when they appear at different positions in a word.</p></article></div>
                <div class="col-lg-4 col-md-6"><article class="am-info-tile p-4 h-100"><span class="am-highlight-icon"><i class="fa-solid fa-ear-listen"></i></span><h3 class="mt-3">Pronunciation</h3><p class="mb-0 text-secondary">Practice clear letter sounds and introductory articulation points (Makharij) with correction and repetition.</p></article></div>
                <div class="col-lg-4 col-md-6"><article class="am-info-tile p-4 h-100"><span class="am-highlight-icon"><i class="fa-solid fa-book-open-reader"></i></span><h3 class="mt-3">Reading Skills</h3><p class="mb-0 text-secondary">Combine letters and vowel marks to read syllables, words and short passages with growing confidence.</p></article></div>
            </div>

            <div class="section-heading text-center mb-4">
                <span>Course Syllabus</span>
                <h2>What You Will Learn</h2>
                <img src="assets/img/icons/title.ico" alt="" />
            </div>
            <div class="row g-3 mb-5">
                <div class="col-lg-4 col-md-6"><div class="am-info-tile p-3 h-100"><strong>01 · Arabic Alphabet</strong><p class="mb-0 mt-2 text-secondary">Identify the letters and their individual forms and sounds.</p></div></div>
                <div class="col-lg-4 col-md-6"><div class="am-info-tile p-3 h-100"><strong>02 · Joined Letters</strong><p class="mb-0 mt-2 text-secondary">Recognize how letters connect to form readable words.</p></div></div>
                <div class="col-lg-4 col-md-6"><div class="am-info-tile p-3 h-100"><strong>03 · Harakaat</strong><p class="mb-0 mt-2 text-secondary">Practice Zabar (Fatha), Zair (Kasra) and Paish (Damma).</p></div></div>
                <div class="col-lg-4 col-md-6"><div class="am-info-tile p-3 h-100"><strong>04 · Madd &amp; Long Vowels</strong><p class="mb-0 mt-2 text-secondary">Learn to recognize and pronounce extended vowel sounds.</p></div></div>
                <div class="col-lg-4 col-md-6"><div class="am-info-tile p-3 h-100"><strong>05 · Tanween</strong><p class="mb-0 mt-2 text-secondary">Read words marked with double vowel signs.</p></div></div>
                <div class="col-lg-4 col-md-6"><div class="am-info-tile p-3 h-100"><strong>06 · Sukoon &amp; Tashdeed</strong><p class="mb-0 mt-2 text-secondary">Practice Jazm/Sukoon and doubled letters with Tashdeed.</p></div></div>
                <div class="col-lg-4 col-md-6"><div class="am-info-tile p-3 h-100"><strong>07 · Hamza &amp; Leen Letters</strong><p class="mb-0 mt-2 text-secondary">Study these letter forms and their sounds in reading exercises.</p></div></div>
                <div class="col-lg-4 col-md-6"><div class="am-info-tile p-3 h-100"><strong>08 · Basic Tajweed</strong><p class="mb-0 mt-2 text-secondary">Meet foundational recitation rules as you progress into Quran reading.</p></div></div>
                <div class="col-lg-4 col-md-6"><div class="am-info-tile p-3 h-100"><strong>09 · Waqf &amp; Stop Signs</strong><p class="mb-0 mt-2 text-secondary">Recognize common pause and stopping signs in Quranic text.</p></div></div>
            </div>

            <div class="row g-4">
                <div class="col-lg-6"><article class="am-info-tile p-4 h-100">
                    <span class="badge bg-success mb-2">Who Can Join</span><h3>For Children, Teens and Adults</h3>
                    <p class="text-secondary">This course is suitable for complete beginners and learners who want to strengthen their reading foundation. No previous Quran reading experience is required to start at the beginning.</p>
                    <ul class="list-unstyled mb-0"><li class="py-1"><i class="fa-solid fa-check text-success me-2"></i>Beginner-friendly step-by-step lessons</li><li class="py-1"><i class="fa-solid fa-check text-success me-2"></i>Individual attention in online classes</li><li class="py-1"><i class="fa-solid fa-check text-success me-2"></i>Flexible scheduling according to availability</li></ul>
                </article></div>
                <div class="col-lg-6"><article class="am-info-tile p-4 h-100">
                    <span class="badge bg-warning text-dark mb-2">Learning Path</span><h3>From Qaida to Quran Reading</h3>
                    <p class="text-secondary">Students learn new sounds, practice with their teacher, review earlier lessons and gradually build accuracy. When ready, they can continue into Nazra Quran reading and further Tajweed study.</p>
                    <ul class="list-unstyled mb-0"><li class="py-1"><i class="fa-solid fa-check text-success me-2"></i>Guided pronunciation and reading practice</li><li class="py-1"><i class="fa-solid fa-check text-success me-2"></i>Regular review of previously learned patterns</li><li class="py-1"><i class="fa-solid fa-check text-success me-2"></i>Progress at a pace suited to the learner</li></ul>
                </article></div>
            </div>
            <div class="mt-5 p-4 text-center rounded bg-white shadow-sm border">
                <h3 class="fw-bold mb-2">Start Your Quran Reading Journey</h3>
                <p class="text-muted mb-4">Tell us about the learner and we can help you choose a suitable starting level.</p>
                <a href="free-trial.aspx" class="green_btn"><span>Book Free Trial Class</span></a>
            </div>
        </div>
    </section>
</asp:Content>
