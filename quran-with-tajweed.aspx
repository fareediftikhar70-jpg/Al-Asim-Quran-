<%@ Page Title="Quran with Tajweed - Al-Asim Quran" Language="vb" MasterPageFile="~/Site.Master" AutoEventWireup="false" %>
<asp:Content ID="PageHead" runat="server" ContentPlaceHolderID="HeadContent">
    <meta name="description" content="Master Holy Quran recitation with precise Makharij, Tajweed rules, and rhythmic fluency with certified instructors at Al-Asim Quran." />
</asp:Content>
<asp:Content ID="PageBody" runat="server" ContentPlaceHolderID="MainContent">
    <section class="am-page-hero">
        <div class="container">
            <div class="row align-items-center g-4">
                <div class="col-lg-7 am-page-hero-copy wow fadeInLeft">
                    <div class="am-page-trail">
                        <a href="Default.aspx">Home</a>
                        <i class="fa-solid fa-chevron-right"></i>
                        <a href="courses.aspx">Courses</a>
                        <i class="fa-solid fa-chevron-right"></i>
                        <span>Quran with Tajweed</span>
                    </div>
                    <span class="am-page-kicker"><i class="fa-solid fa-microphone"></i> Course 2: Beautiful Recitation</span>
                    <h1>Quran with Tajweed</h1>
                    <p>Master the divine art of Quran recitation with proper articulation points (Makharij), Tajweed rules, and melodic rhythm as taught by Prophet Muhammad ﷺ.</p>
                    <div class="am-page-actions">
                        <a class="green_btn" href="free-trial.aspx"><span>Book Free Trial Class</span></a>
                        <a class="am-page-text-link" href="inquiry.aspx">Get Details <i class="fa-solid fa-arrow-right"></i></a>
                    </div>
                </div>
                <div class="col-lg-5 wow fadeInRight" data-wow-delay=".2s">
                    <div class="am-page-photo-frame">
                        <span class="am-photo-orbit"></span>
                        <img class="am-page-photo" src="assets/img/courses/2.jpg" alt="Tajweed recitation class" />
                        <div class="am-page-photo-caption">
                            <i class="fa-solid fa-music"></i>
                            <span>Art of Quranic Recitation</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="section-padding am-info-section">
        <div class="container">
            <div class="section-heading text-center mb-50">
                <span>The Science of Tajweed</span>
                <h2>Course Pillars &amp; Methodology</h2>
                <img src="assets/img/icons/title.ico" alt="" />
            </div>

            <div class="row g-4 mb-5">
                <!-- Pillar 1 -->
                <div class="col-lg-3 col-md-6 wow fadeInUp" data-wow-delay=".1s">
                    <div class="am-info-tile p-4 h-100 text-center">
                        <span class="am-highlight-icon"><i class="fa-solid fa-lungs"></i></span>
                        <h4 class="mt-3">Makharij (Articulation)</h4>
                        <p class="mb-0 text-secondary">Accurate throat, tongue, and lip points for every letter, preventing common mispronunciations that alter meanings.</p>
                    </div>
                </div>
                <!-- Pillar 2 -->
                <div class="col-lg-3 col-md-6 wow fadeInUp" data-wow-delay=".15s">
                    <div class="am-info-tile p-4 h-100 text-center">
                        <span class="am-highlight-icon"><i class="fa-solid fa-scale-balanced"></i></span>
                        <h4 class="mt-3">Tajweed Rules</h4>
                        <p class="mb-0 text-secondary">Comprehensive study of Noon Sakinah &amp; Tanween (Izhar, Idgham, Iqlab, Ikhfa), Meem Sakinah, and Qalqalah.</p>
                    </div>
                </div>
                <!-- Pillar 3 -->
                <div class="col-lg-3 col-md-6 wow fadeInUp" data-wow-delay=".2s">
                    <div class="am-info-tile p-4 h-100 text-center">
                        <span class="am-highlight-icon"><i class="fa-solid fa-water"></i></span>
                        <h4 class="mt-3">Fluency Training</h4>
                        <p class="mb-0 text-secondary">Breathing control, pauses, continuation (Waqf &amp; Ibtida), and rhythm for continuous recitation without hesitation.</p>
                    </div>
                </div>
                <!-- Pillar 4 -->
                <div class="col-lg-3 col-md-6 wow fadeInUp" data-wow-delay=".25s">
                    <div class="am-info-tile p-4 h-100 text-center">
                        <span class="am-highlight-icon"><i class="fa-solid fa-headphones"></i></span>
                        <h4 class="mt-3">Recitation Practice</h4>
                        <p class="mb-0 text-secondary">Direct repetitive recitation before certified Qaris, receiving immediate feedback and corrections in every session.</p>
                    </div>
                </div>
            </div>

            <div class="p-4 bg-light rounded-3 border">
                <h4 class="fw-bold mb-3"><i class="fa-solid fa-award text-success me-2"></i>Curriculum In-Depth:</h4>
                <div class="row g-3">
                    <div class="col-md-6">
                        <ul class="list-unstyled mb-0">
                            <li class="py-2 border-bottom"><i class="fa-solid fa-circle-check text-success me-2"></i> Letters characteristics: Hams, Jahr, Shiddah, Tawassut, Rakhawah</li>
                            <li class="py-2 border-bottom"><i class="fa-solid fa-circle-check text-success me-2"></i> Heavy vs. light letters (Tafkheem &amp; Tarqeeq of Ra and Lam)</li>
                            <li class="py-2"><i class="fa-solid fa-circle-check text-success me-2"></i> Rules of Ghunnah (nasal sound) and Madd (elongations: 2, 4, 6 counts)</li>
                        </ul>
                    </div>
                    <div class="col-md-6">
                        <ul class="list-unstyled mb-0">
                            <li class="py-2 border-bottom"><i class="fa-solid fa-circle-check text-success me-2"></i> Stopping signs in Mus'haf (Meem, Jeem, Qaf-Lam, Sad-Lam)</li>
                            <li class="py-2 border-bottom"><i class="fa-solid fa-circle-check text-success me-2"></i> Practical recitation of Juz 30 and selected long Surahs</li>
                            <li class="py-2"><i class="fa-solid fa-circle-check text-success me-2"></i> Certificate of Tajweed Completion upon graduation</li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="mt-5 p-4 text-center rounded bg-white shadow-sm border">
                <h4 class="fw-bold mb-2">Recite with Confidence &amp; Beauty</h4>
                <p class="text-muted mb-4">Book your free trial and have our Tajweed instructor assess your recitation.</p>
                <a href="free-trial.aspx" class="green_btn"><span>Book Free Trial Class</span></a>
            </div>
        </div>
    </section>
</asp:Content>
