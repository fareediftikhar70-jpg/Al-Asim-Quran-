<%@ Page Title="Quran Reading for Beginners (Nazra) - Al-Asim Quran" Language="vb" MasterPageFile="~/Site.Master" AutoEventWireup="false" %>
<asp:Content ID="PageHead" runat="server" ContentPlaceHolderID="HeadContent">
    <meta name="description" content="Learn Quran reading from basic Arabic alphabet and Noorani Qaida to fluent recitation with one-on-one certified tutors at Al-Asim Quran." />
</asp:Content>
<asp:Content ID="PageBody" runat="server" ContentPlaceHolderID="MainContent">
    <section class="am-page-hero">
        <div class="container">
            <div class="row align-items-center g-4">
                <div class="col-lg-7 am-page-hero-copy wow fadeInLeft">
                    <div class="am-page-trail">
                        <a href="Default.aspx">Home</a>
                        <i class="fa-solid fa-chevron-right"></i>
                        <a href="courses.aspx">Courses</a>
                        <i class="fa-solid fa-chevron-right"></i>
                        <span>Quran Reading for Beginners</span>
                    </div>
                    <span class="am-page-kicker"><i class="fa-solid fa-book-open"></i> Course 1: Foundational Recitation</span>
                    <h1>Quran Reading for Beginners</h1>
                    <p>Build Quran reading skills step by step: recognize Arabic letters, read vowel signs and connected words, and practice reciting with clear pronunciation and introductory Tajweed.</p>
                    <div class="am-page-actions">
                        <a class="green_btn" href="free-trial.aspx"><span>Book Free Trial Class</span></a>
                        <a class="am-page-text-link" href="inquiry.aspx">Inquire About Fees <i class="fa-solid fa-arrow-right"></i></a>
                    </div>
                </div>
                <div class="col-lg-5 wow fadeInRight" data-wow-delay=".2s">
                    <div class="am-page-photo-frame">
                        <span class="am-photo-orbit"></span>
                        <img class="am-page-photo" src="assets/img/courses/1.jpg" alt="Child learning Noorani Qaida" />
                        <div class="am-page-photo-caption">
                            <i class="fa-solid fa-star"></i>
                            <span>Noorani Qaida to Fluent Nazra</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="section-padding am-info-section">
        <div class="container">
            <div class="section-heading text-center mb-50">
                <span>Core Modules</span>
                <h2>Course Highlights &amp; Curriculum</h2>
                <img src="assets/img/icons/title.ico" alt="" />
            </div>

            <div class="row g-4 mb-5">
                <!-- Module 1 -->
                <div class="col-lg-3 col-md-6 wow fadeInUp" data-wow-delay=".1s">
                    <div class="am-info-tile p-4 h-100 text-center">
                        <span class="am-highlight-icon"><i class="fa-solid fa-font"></i></span>
                        <h4 class="mt-3">Arabic Letters &amp; Sounds</h4>
                        <p class="mb-0 text-secondary">Recognize Quranic letters, their shapes and sounds, and build the reading foundation needed for connected text.</p>
                    </div>
                </div>
                <!-- Module 2 -->
                <div class="col-lg-3 col-md-6 wow fadeInUp" data-wow-delay=".15s">
                    <div class="am-info-tile p-4 h-100 text-center">
                        <span class="am-highlight-icon"><i class="fa-solid fa-microphone-lines"></i></span>
                        <h4 class="mt-3">Vowels &amp; Word Formation</h4>
                        <p class="mb-0 text-secondary">Practice short and long vowel marks, Tanween, Sukoon and Tashkeel while learning how letters join to form words.</p>
                    </div>
                </div>
                <!-- Module 3 -->
                <div class="col-lg-3 col-md-6 wow fadeInUp" data-wow-delay=".2s">
                    <div class="am-info-tile p-4 h-100 text-center">
                        <span class="am-highlight-icon"><i class="fa-solid fa-book-quran"></i></span>
                        <h4 class="mt-3">Guided Quran Reading</h4>
                        <p class="mb-0 text-secondary">Move gradually from short words and passages to Quranic verses, with regular practice for clearer and more fluent reading.</p>
                    </div>
                </div>
                <!-- Module 4 -->
                <div class="col-lg-3 col-md-6 wow fadeInUp" data-wow-delay=".25s">
                    <div class="am-info-tile p-4 h-100 text-center">
                        <span class="am-highlight-icon"><i class="fa-solid fa-user-check"></i></span>
                        <h4 class="mt-3">Personal Learning Support</h4>
                        <p class="mb-0 text-secondary">Receive individual guidance, pronunciation correction and a learning pace suited to your current reading level.</p>
                    </div>
                </div>
            </div>

            <!-- Features details -->
            <div class="row g-4">
                <div class="col-lg-6">
                    <div class="p-4 bg-light rounded-3 h-100 border">
                        <h4 class="fw-bold mb-3"><i class="fa-solid fa-list-check text-success me-2"></i>What the Student Will Learn:</h4>
                        <ul class="list-unstyled">
                            <li class="py-2 border-bottom"><i class="fa-solid fa-check text-success me-2"></i> Arabic alphabet, letter sounds and articulation points</li>
                            <li class="py-2 border-bottom"><i class="fa-solid fa-check text-success me-2"></i> Short and long vowels, Madd and Tanween</li>
                            <li class="py-2 border-bottom"><i class="fa-solid fa-check text-success me-2"></i> Connected letters, word formation and Quranic text practice</li>
                            <li class="py-2 border-bottom"><i class="fa-solid fa-check text-success me-2"></i> Introductory Tajweed such as Ikhfa, Idgham, Iqlab and Qalqalah</li>
                            <li class="py-2"><i class="fa-solid fa-check text-success me-2"></i> Recitation review and teacher feedback to guide progress</li>
                        </ul>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="p-4 bg-light rounded-3 h-100 border">
                        <h4 class="fw-bold mb-3"><i class="fa-solid fa-clock text-primary me-2"></i>Learning Format:</h4>
                        <ul class="list-unstyled">
                            <li class="py-2 border-bottom"><strong>Start point:</strong> Learners can begin with letters or build on existing reading skills</li>
                            <li class="py-2 border-bottom"><strong>Class style:</strong> Online lessons with individual teacher guidance</li>
                            <li class="py-2 border-bottom"><strong>Practice:</strong> Recitation exercises and review between lessons</li>
                            <li class="py-2 border-bottom"><strong>Scheduling:</strong> Class times arranged according to availability</li>
                            <li class="py-2"><strong>Next step:</strong> Continue into Nazra reading, Tajweed or Hifz as appropriate</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- CTA -->
            <div class="mt-5 p-4 text-center rounded bg-white shadow-sm border">
                <h4 class="fw-bold mb-2">Begin Your Quran Reading Journey Today</h4>
                <p class="text-muted mb-4">Book a complimentary trial class and let our teacher evaluate your or your child's level.</p>
                <a href="free-trial.aspx" class="green_btn"><span>Book Free Trial Class</span></a>
            </div>
        </div>
    </section>
</asp:Content>
