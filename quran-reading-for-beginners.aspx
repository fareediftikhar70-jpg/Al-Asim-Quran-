<%@ Page Title="Quran Reading for Beginners (Nazra) - Al-Asim Quran" Language="vb" MasterPageFile="~/Site.Master" AutoEventWireup="false" %>
<asp:Content ID="PageHead" runat="server" ContentPlaceHolderID="HeadContent">
    <meta name="description" content="Learn Quran reading from basic Arabic alphabet and Noorani Qaida to fluent recitation with one-on-one certified tutors at Al-Asim Quran." />
</asp:Content>
<asp:Content ID="PageBody" runat="server" ContentPlaceHolderID="MainContent">
    <section class="am-page-hero">
        <div class="container">
            <div class="row align-items-center g-4">
                <div class="col-lg-7 am-page-hero-copy wow fadeInLeft">
                    <div class="am-page-trail">
                        <a href="Default.aspx">Home</a>
                        <i class="fa-solid fa-chevron-right"></i>
                        <a href="courses.aspx">Courses</a>
                        <i class="fa-solid fa-chevron-right"></i>
                        <span>Quran Reading for Beginners</span>
                    </div>
                    <span class="am-page-kicker"><i class="fa-solid fa-book-open"></i> Course 1: Foundational Recitation</span>
                    <h1>Quran Reading for Beginners</h1>
                    <p>Learn the basics of Quran reading from individual Arabic letters and vowel marks to fluent recitation (Nazra) under the caring guidance of qualified instructors.</p>
                    <div class="am-page-actions">
                        <a class="green_btn" href="free-trial.aspx"><span>Book Free Trial Class</span></a>
                        <a class="am-page-text-link" href="inquiry.aspx">Inquire About Fees <i class="fa-solid fa-arrow-right"></i></a>
                    </div>
                </div>
                <div class="col-lg-5 wow fadeInRight" data-wow-delay=".2s">
                    <div class="am-page-photo-frame">
                        <span class="am-photo-orbit"></span>
                        <img class="am-page-photo" src="assets/img/courses/1.jpg" alt="Child learning Noorani Qaida" />
                        <div class="am-page-photo-caption">
                            <i class="fa-solid fa-star"></i>
                            <span>Noorani Qaida to Fluent Nazra</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="section-padding am-info-section">
        <div class="container">
            <div class="section-heading text-center mb-50">
                <span>Core Modules</span>
                <h2>Course Highlights &amp; Curriculum</h2>
                <img src="assets/img/icons/title.ico" alt="" />
            </div>

            <div class="row g-4 mb-5">
                <!-- Module 1 -->
                <div class="col-lg-3 col-md-6 wow fadeInUp" data-wow-delay=".1s">
                    <div class="am-info-tile p-4 h-100 text-center">
                        <span class="am-highlight-icon"><i class="fa-solid fa-font"></i></span>
                        <h4 class="mt-3">Noorani Qaida</h4>
                        <p class="mb-0 text-secondary">Step-by-step mastery of Arabic alphabet shapes, joined forms, Harakaat (Fatha, Kasra, Damma), Sukoon, and Tanween.</p>
                    </div>
                </div>
                <!-- Module 2 -->
                <div class="col-lg-3 col-md-6 wow fadeInUp" data-wow-delay=".15s">
                    <div class="am-info-tile p-4 h-100 text-center">
                        <span class="am-highlight-icon"><i class="fa-solid fa-microphone-lines"></i></span>
                        <h4 class="mt-3">Arabic Pronunciation</h4>
                        <p class="mb-0 text-secondary">Correct pronunciation of heavy and light throat letters (Makharij) so the student learns the sound accurately from day one.</p>
                    </div>
                </div>
                <!-- Module 3 -->
                <div class="col-lg-3 col-md-6 wow fadeInUp" data-wow-delay=".2s">
                    <div class="am-info-tile p-4 h-100 text-center">
                        <span class="am-highlight-icon"><i class="fa-solid fa-book-quran"></i></span>
                        <h4 class="mt-3">Reading Practice</h4>
                        <p class="mb-0 text-secondary">Gradual progression from short compound words and phrases to full Quranic verses with smooth fluency and rhythm.</p>
                    </div>
                </div>
                <!-- Module 4 -->
                <div class="col-lg-3 col-md-6 wow fadeInUp" data-wow-delay=".25s">
                    <div class="am-info-tile p-4 h-100 text-center">
                        <span class="am-highlight-icon"><i class="fa-solid fa-user-check"></i></span>
                        <h4 class="mt-3">One-on-One Classes</h4>
                        <p class="mb-0 text-secondary">Dedicated individual attention ensuring patient correction, repeated practice, and lessons tailored to student's pace.</p>
                    </div>
                </div>
            </div>

            <!-- Features details -->
            <div class="row g-4">
                <div class="col-lg-6">
                    <div class="p-4 bg-light rounded-3 h-100 border">
                        <h4 class="fw-bold mb-3"><i class="fa-solid fa-list-check text-success me-2"></i>What the Student Will Learn:</h4>
                        <ul class="list-unstyled">
                            <li class="py-2 border-bottom"><i class="fa-solid fa-check text-success me-2"></i> Recognition of all 29 Arabic letters and their connected forms</li>
                            <li class="py-2 border-bottom"><i class="fa-solid fa-check text-success me-2"></i> Short vowels (Zabar, Zair, Paish) and long vowels (Maddah)</li>
                            <li class="py-2 border-bottom"><i class="fa-solid fa-check text-success me-2"></i> Tanween, Sukoon/Jazm, Tashdeed/Shaddah, and silent letters</li>
                            <li class="py-2 border-bottom"><i class="fa-solid fa-check text-success me-2"></i> Transitioning smoothly into the 30th Juz (Amma Para)</li>
                            <li class="py-2"><i class="fa-solid fa-check text-success me-2"></i> Memorization of short daily Duas, Kalimas, and basic Salah steps</li>
                        </ul>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="p-4 bg-light rounded-3 h-100 border">
                        <h4 class="fw-bold mb-3"><i class="fa-solid fa-clock text-primary me-2"></i>Class Schedule &amp; Format:</h4>
                        <ul class="list-unstyled">
                            <li class="py-2 border-bottom"><strong>Duration:</strong> 30 minutes per class (optimal for young focus)</li>
                            <li class="py-2 border-bottom"><strong>Frequency:</strong> 3 days or 5 days per week options</li>
                            <li class="py-2 border-bottom"><strong>Platform:</strong> Zoom / Google Meet with digital screen sharing</li>
                            <li class="py-2 border-bottom"><strong>Teachers:</strong> Certified male &amp; female educators available</li>
                            <li class="py-2"><strong>Trial:</strong> Free 30-minute evaluation session before enrollment</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- CTA -->
            <div class="mt-5 p-4 text-center rounded bg-white shadow-sm border">
                <h4 class="fw-bold mb-2">Begin Your Quran Reading Journey Today</h4>
                <p class="text-muted mb-4">Book a complimentary trial class and let our teacher evaluate your or your child's level.</p>
                <a href="free-trial.aspx" class="green_btn"><span>Book Free Trial Class</span></a>
            </div>
        </div>
    </section>
</asp:Content>
